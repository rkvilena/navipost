{
  "name": "navipost",
  "displayName": "Navipost",
  "version": "0.0.1",
  "description": "A 3rd party application to support folder structure of bookmark in X/Twitter",
  "author": "rkvilena (rkvilena11@gmail.com)",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "tailwindcss": "3.4.1",
    "postcss": "8.4.35",
    "autoprefixer": "10.4.17",
    "typescript": "5.3.3"
  },
  "manifest": {
    "permissions": [
      "sidePanel",
      "storage",
      "tabs"
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    },
    "host_permissions": [
      "https://x.com/*",
      "https://twitter.com/*"
    ]
  }
}
